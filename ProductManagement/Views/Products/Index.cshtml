@model IEnumerable<ProductManagement.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>
        <a class="btn btn-primary" href="@Url.Action("Create")">Add Product</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th style="width:120px">Price</th>
                <th>Images</th>
                <th style="width:200px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@String.Format("{0:C}", p.Price)</td>
                    <td>
                        @if (p.Images != null && p.Images.Any())
                        {
                            <div class="d-flex gap-2">
                                @foreach (var img in p.Images.Take(4))
                                {
                                    <img src="@img.ImageUrl" style="width:60px;height:60px;object-fit:cover;border-radius:4px" />
                                }
                                @if (p.Images.Count > 4)
                                {
                                    <span class="badge bg-secondary align-self-center">+@((p.Images.Count) - 4)</span>
                                }
                            </div>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-info" href="@Url.Action("Details", new { id = p.Id })">Details</a>
                        <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", new { id = p.Id })">Edit</a>
                        <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = p.Id })">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
